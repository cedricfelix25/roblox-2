ROBLOX 2 - Système Complet : Administration, Boutique & Multiplateforme
Ce document contient l'intégralité du code source (Script Lua) pour configurer ton serveur avec tous les privilèges d'Admin Suprême (Grand Boss), la gestion des Robux virtuels, le système complet de Boutique (Shop / Gamepasses / Objets / Vêtements), l'apparition de cartes et la liste complète des commandes utilisables.


🛍️ 1. Script Lua Officiel - Boutique & Administration (À copier dans ServerScriptService)
-- ====================================================

-- SCRIPT COMPLET : ADMIN, BOUTIQUE & MULTIPLATEFORME - ROBLOX 2

-- COMPATIBILITÉ : PC, XBOX, NINTENDO, IOS, ANDROID, TABLETTES

-- ====================================================

local Players = game:GetService("Players")

local MarketplaceService = game:GetService("MarketplaceService")

-- INSCRIS TON PSEUDO EXACT ICI :

local GRAND_BOSS = "TonPseudoRoblox" 

-- Tables de gestion

local RolesJoueurs = {}

local RobuxJoueurs = {}

local InventaireBoutique = {}

local TchatGlobalMute = false

local JoueursMutes = {}

-- Catalogue de la Boutique du Jeu (ID, Nom, Prix en Robux virtuels)

local CatalogueBoutique = {

	["vip"] = {nom = "Pass VIP & Effets Dorés", prix = 500},

	["sword"] = {nom = "Épée Légendaire", prix = 1200},

	["wings"] = {nom = "Ailes d'Ange Volantes", prix = 2500},

	["speedcoil"] = {nom = "Coil de Vitesse Max", prix = 300}

}

Players.PlayerAdded:Connect(function(player)

	if player.Name == GRAND_BOSS then

		RolesJoueurs[player.Name] = 3

		RobuxJoueurs[player.Name] = 999999999

		print("👑 Le Grand Boss " .. player.Name .. " a rejoint le serveur avec TOUS LES POUVOIRS ET ROBUX ILLIMITÉS !")

	else

		RolesJoueurs[player.Name] = 0

		RobuxJoueurs[player.Name] = 100 -- Offre de bienvenue pour tester la boutique

	end

	InventaireBoutique[player.Name] = {}

	JoueursMutes[player.Name] = false

	-- Gestionnaire de commandes tchat & Boutique

	player.Chatted:Connect(function(message)

		local args = string.split(message, " ")

		local commande = string.lower(args[1])

		local cibleNom = args[2]

		-- Commandes de la Boutique (Accessibles à tous)

		if commande == ";shop" or commande == ";store" then

			print("🛒 --- CATALOGUE DE LA BOUTIQUE ROBLOX 2 ---")

			for id, item in pairs(CatalogueBoutique) do

				print("• [" .. id .. "] " .. item.nom .. " - Prix : " .. item.prix .. " Robux (Commande : ;buy " .. id .. ")")

			end

			

		elseif commande == ";buy" and args[2] then

			local itemId = string.lower(args[2])

			local article = CatalogueBoutique[itemId]

			if article then

				local soldeActuel = RobuxJoueurs[player.Name] or 0

				if soldeActuel >= article.prix then

					RobuxJoueurs[player.Name] = soldeActuel - article.prix

					table.insert(InventaireBoutique[player.Name], itemId)

					print("🎉 Achat réussi ! " .. player.Name + " a acheté " .. article.nom)

				else

					print("❌ Solde insuffisant ! Il te manque des Robux.")

				end

			else

				print("❌ Cet article n'existe pas dans la boutique.")

			end

		elseif commande == ";inventory" or commande == ";inv" then

			print("🎒 Inventaire de " .. player.Name .. " :")

			for _, itemId in ipairs(InventaireBoutique[player.Name] or {}) do

				print(" - " .. CatalogueBoutique[itemId].nom)

			end

		end

		-- Commandes Réservées au Grand Boss (Niveau 3)

		if RolesJoueurs[player.Name] == 3 then

			if commande == ";admin" and cibleNom then

				RolesJoueurs[cibleNom] = 2

				print("✨ " .. player.Name .. " a promu " .. cibleNom .. " au rang d'ADMIN.")

			elseif commande == ";unadmin" and cibleNom then

				RolesJoueurs[cibleNom] = 0

				print("🚫 " .. player.Name .. " a retiré tous les pouvoirs de " .. cibleNom)

			elseif commande == ";giverobux" and cibleNom and args[3] then

				local montant = tonumber(args[3]) or 1000

				RobuxJoueurs[cibleNom] = (RobuxJoueurs[cibleNom] or 0) + montant

				print("💰 " .. player.Name .. " a donné " .. montant .. " Robux virtuels à " .. cibleNom .. " !")

			end

		end

		-- Commandes d'Action Admin (Niveau >= 2)

		if RolesJoueurs[player.Name] >= 2 then

			if commande == ";muteall" then

				TchatGlobalMute = true

				print("🔇 Tchat global désactivé.")

			elseif commande == ";unmuteall" then

				TchatGlobalMute = false

				print("🔊 Tchat global réactivé.")

			elseif commande == ";fly" then

				print("🕊️ Mode vol activé.")

			elseif commande == ";god" then

				if player.Character and player.Character:FindFirstChild("Humanoid") then

					player.Character.Humanoid.MaxHealth = math.huge

					player.Character.Humanoid.Health = math.huge

					print("🛡️ Invincibilité activée !")

				end

			elseif commande == ";map" and args[2] then

				print("🗺️ Chargement de la carte : " .. args[2])

			end

		end

	end)

end)


